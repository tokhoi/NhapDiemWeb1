@page "/quan-ly-hoc-sinh"
@rendermode InteractiveServer

<div class="student-page-container">
    @* --- SIDEBAR TRÁI --- *@
    <div class="sidebar-box">
        <div class="sidebar-header">
            <i class="fa-solid fa-layer-group"></i> CẤU TRÚC LỚP
        </div>
        <div class="sidebar-content">
            @foreach (var g in grades)
            {
                <div class="grade-group">
                    <div class="grade-row @(g.IsExpanded ? "expanded" : "")" @onclick="() => ToggleGrade(g)">
                        <span class="fw-bold">@g.Name</span>
                        <div class="grade-meta">
                            <span class="badge-count">@g.Classes.Count lớp</span>
                            <i class="fa-solid fa-chevron-down arrow-icon"></i>
                        </div>
                    </div>

                    @if (g.IsExpanded)
                    {
                        <div class="class-list">
                            @foreach (var c in g.Classes)
                            {
                                <div class="class-row @(selectedClass?.Id == c.Id ? "active" : "")" @onclick="() => SelectClass(c)">
                                    <div class="class-icon"><i class="fa-solid fa-users"></i></div>
                                    <div class="class-info">
                                        <div class="class-name">@c.Name</div>
                                        <div class="class-sub">Sĩ số: @c.StudentCount</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @* --- MAIN CONTENT --- *@
    <div class="main-content-box">
        @if (selectedClass == null)
        {
            <div class="empty-state">
                <i class="fa-solid fa-school-circle-exclamation icon-empty"></i>
                <h5>Chưa chọn lớp học</h5>
                <p>Vui lòng chọn một lớp từ danh sách bên trái để xem dữ liệu.</p>
            </div>
        }
        else
        {
            <div class="content-head">
                <div class="head-info">
                    <h4>Danh sách học sinh - @selectedClass.Name</h4>
                    <span><i class="fa-solid fa-folder-tree"></i> Khối @selectedClass.GradeName &nbsp;|&nbsp; <i class="fa-solid fa-user-graduate"></i> GVCN: @selectedClass.HomeroomTeacher</span>
                </div>
                <div class="head-actions">
                    <div class="search-wrap">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" placeholder="Tìm kiếm tên, mã HS..." @bind="searchText" @bind:event="oninput" @onkeyup="ResetPage" />
                    </div>
                    <button class="btn-custom btn-green"><i class="fa-solid fa-file-excel"></i> Xuất Excel</button>
                    @* <button class="btn-custom btn-blue"><i class="fa-solid fa-user-plus"></i> Thêm mới</button> *@
                </div>
            </div>

            <div class="content-table">
                <table class="std-table">
                    <thead>
                        <tr>
                            <th width="50" class="text-center">#</th>
                            <th width="100">Mã HS</th>
                            <th>Họ và tên</th>
                            <th width="120">Ngày sinh</th>
                            <th width="100">Giới tính</th>
                            <th width="120">SĐT</th>
                            <th width="120" class="text-center">Trạng thái</th>
                            <th width="100" class="text-end">Tác vụ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (PagedStudents.Any())
                        {
                            int index = (currentPage - 1) * pageSize + 1;
                            foreach (var s in PagedStudents)
                            {
                                <tr>
                                    <td class="text-center text-muted">@(index++)</td>
                                    <td><span class="code-tag">@s.Code</span></td>
                                    <td class="fw-bold" style="color:#333">@s.Name</td>
                                    <td>@s.Dob.ToString("dd/MM/yyyy")</td>
                                    <td>@s.Gender</td>
                                    <td>@s.Phone</td>
                                    <td class="text-center"><span class="status-tag active">@s.Status</span></td>
                                    <td class="text-end">
                                        <button class="btn-icon text-blue"><i class="fa-solid fa-pen"></i></button>
                                        <button class="btn-icon text-red"><i class="fa-solid fa-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="8" class="text-center py-4 text-muted">Không tìm thấy học sinh nào.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="content-foot">
                <span>Hiển thị @((currentPage - 1) * pageSize + 1) - @Math.Min(currentPage * pageSize, FilteredStudents.Count) trên @FilteredStudents.Count học sinh</span>
                <div class="pagination-wrap">
                    <button @onclick="() => ChangePage(currentPage - 1)" disabled="@(currentPage == 1)"><i class="fa-solid fa-chevron-left"></i></button>
                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        var p = i;
                        if (i == 1 || i == TotalPages || (i >= currentPage - 1 && i <= currentPage + 1))
                        {
                            <button class="@(currentPage == p ? "active" : "")" @onclick="() => ChangePage(p)">@p</button>
                        }
                        else if (i == currentPage - 2 || i == currentPage + 2)
                        {
                            <span class="dots">...</span>
                        }
                    }
                    <button @onclick="() => ChangePage(currentPage + 1)" disabled="@(currentPage == TotalPages)"><i class="fa-solid fa-chevron-right"></i></button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    class Grade { public int Id { get; set; } public string Name { get; set; } = ""; public bool IsExpanded { get; set; } = true; public List<Class> Classes { get; set; } = new(); }
    class Class { public int Id { get; set; } public string Name { get; set; } = ""; public string GradeName { get; set; } = ""; public int StudentCount { get; set; } public string HomeroomTeacher { get; set; } = ""; }
    class Student { public string Code { get; set; } = ""; public string Name { get; set; } = ""; public DateTime Dob { get; set; } public string Gender { get; set; } = ""; public string Phone { get; set; } = ""; public string Status { get; set; } = "Đang học"; }

    List<Grade> grades = new();
    List<Student> currentStudents = new();
    Class? selectedClass;
    string searchText = "";
    int currentPage = 1;
    int pageSize = 15;

    List<Student> FilteredStudents => currentStudents.Where(s => string.IsNullOrEmpty(searchText) || s.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) || s.Code.Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList();
    List<Student> PagedStudents => FilteredStudents.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    int TotalPages => (int)Math.Ceiling((double)FilteredStudents.Count / pageSize);

    protected override void OnInitialized()
    {
        var k10 = new Grade { Id = 10, Name = "KHỐI 10" };
        k10.Classes.Add(new Class { Id = 1, Name = "10A1", GradeName = "10", StudentCount = 45, HomeroomTeacher = "Nguyễn Văn A" });
        k10.Classes.Add(new Class { Id = 2, Name = "10A2", GradeName = "10", StudentCount = 42, HomeroomTeacher = "Trần Thị B" });
        var k11 = new Grade { Id = 11, Name = "KHỐI 11", IsExpanded = false };
        k11.Classes.Add(new Class { Id = 3, Name = "11B1", GradeName = "11", StudentCount = 40, HomeroomTeacher = "Lê Văn C" });
        grades.Add(k10); grades.Add(k11); grades.Add(new Grade { Id = 12, Name = "KHỐI 12", IsExpanded = false });
        SelectClass(k10.Classes[0]);
    }

    void ToggleGrade(Grade g) => g.IsExpanded = !g.IsExpanded;
    void SelectClass(Class c) { selectedClass = c; searchText = ""; currentPage = 1; LoadStudents(c.Id); }
    void ResetPage() => currentPage = 1;
    void ChangePage(int p) { if (p >= 1 && p <= TotalPages) currentPage = p; }

    void LoadStudents(int classId)
    {
        currentStudents.Clear();
        int count = selectedClass?.StudentCount ?? 45;
        if (count < 50) count = 50;
        for (int i = 1; i <= count; i++)
        {
            currentStudents.Add(new Student { Code = $"HS{classId}{i:000}", Name = $"Học sinh mẫu {i} ({selectedClass?.Name})", Dob = DateTime.Now.AddYears(-16), Gender = i % 2 == 0 ? "Nữ" : "Nam", Phone = "0988777666" });
        }
    }
}

