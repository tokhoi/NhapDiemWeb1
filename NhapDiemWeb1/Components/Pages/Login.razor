@page "/"
@rendermode InteractiveServer
@layout EmptyLayout
@inject NavigationManager Nav


<div class="login-page">
    <div class="login-card">
        <div class="brand-side">
            <div class="content">
                <i class="fa-solid fa-graduation-cap logo-large"></i>
                <h2>TITKUL</h2>
                <p>Nền tảng quản lý giáo dục thông minh</p>
                <div class="features">
                    <div><i class="fa-solid fa-pen"></i><br>Nhập liệu</div>
                    <div><i class="fa-solid fa-rotate"></i><br>Đồng bộ</div>
                    <div><i class="fa-solid fa-shield-halved"></i><br>Bảo mật</div>
                </div>
            </div>
            <div class="bg-overlay"></div>
        </div>

        <div class="form-side">
            <div class="form-header">
                <div class="icon-lock"><i class="fa-solid fa-lock"></i></div>
                <div>
                    <h4>ĐĂNG NHẬP HỆ THỐNG</h4>
                    <span class="sub-text">Dành cho Cán bộ Quản lý & Giáo viên</span>
                </div>
            </div>

            <div class="form-body">
                <div class="form-group">
                    <label>TÀI KHOẢN CỦA BẠN</label>
                    <div class="input-group">
                        <span class="input-icon"><i class="fa-solid fa-user"></i></span>
                        <input type="text" placeholder="Tên đăng nhập / Email" />
                    </div>
                </div>

                <div class="form-group">
                    <label>MẬT KHẨU</label>
                    <div class="input-group">
                        <span class="input-icon"><i class="fa-solid fa-key"></i></span>
                        <input type="password" placeholder="Mật khẩu" />
                    </div>
                </div>

                <div class="divider">THÔNG TIN ĐƠN VỊ</div>

              @*   <select class="form-select"><option>Trung học phổ thông</option></select>
                <select class="form-select"><option>-- Chọn Quận/Huyện --</option></select> *@
                <div class="searchable-select">
                    <input type="text"
                           class="form-select fw-bold"
                           placeholder="-- Nhập tên trường để tìm --"
                           @bind="searchText"
                           @bind:event="oninput"
                           @onfocus="ShowDropdown"
                           @onblur="HideDropdownDelay" />


                    @if (isDropdownOpen)
                    {
                        <div class="dropdown-list shadow">
                            @if (filteredSchools.Count == 0)
                            {
                                <div class="dropdown-item text-muted">Không tìm thấy kết quả</div>
                            }
                            else
                            {
                                @foreach (var school in filteredSchools)
                                {
                                    <div class="dropdown-item" @onmousedown="() => SelectSchool(school)">
                                        @school
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
              @*   <div class="captcha-row">
                    <input type="text" placeholder="Mã xác nhận" class="captcha-input" />
                    <div class="captcha-code">A7x9B2</div>
                    <button class="btn-refresh"><i class="fa-solid fa-rotate-right"></i></button>
                </div> *@

                <div class="remember-row">
                    <label class="d-flex align-center"><input type="checkbox"> Ghi nhớ</label>
                    <a href="#" class="forgot-pass">Quên mật khẩu?</a>
                </div>

                <button class="btn-submit" @onclick='() => Nav.NavigateTo("/dashboard")'>ĐĂNG NHẬP</button>
                @* <button class="btn-vneid">Đăng nhập bằng tài khoản VNeID</button> *@
            </div>
        </div>
    </div>
</div>
@code {
    // --- LOGIC SEARCHABLE DROPDOWN ---
    bool isDropdownOpen = false;
    private string _searchText = "THPT SAO MAI";

    public string searchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            if (string.IsNullOrWhiteSpace(_searchText))
                filteredSchools = allSchools;
            else
                filteredSchools = allSchools.Where(s => s.Contains(_searchText, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    List<string> allSchools = new List<string>
    {
        "THPT SAO MAI",
        "THPT A",
        "THPT B",
        "THPT C"
    };

    List<string> filteredSchools = new List<string>();

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(searchText))
            searchText = "THPT SAO MAI";

        filteredSchools = allSchools;
    }

    void ShowDropdown()
    {
        isDropdownOpen = true;
        if (string.IsNullOrWhiteSpace(searchText))
            filteredSchools = allSchools;
        else
            filteredSchools = allSchools.Where(s => s.Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    async Task HideDropdownDelay()
    {
        await Task.Delay(200);
        isDropdownOpen = false;
    }

    void SelectSchool(string school)
    {
        searchText = school;
        isDropdownOpen = false;
    }
}